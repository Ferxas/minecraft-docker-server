# MapBrowser displays are RAM-only; /mb create must run as a real player (not console/execute-as).
# Recreate when someone with mapbrowser.command.create is in SakuraSpawn after restart.

on load:
    delete {mapbrowser_auto::restored}

function mapbrowserRestoreAs(p: player):
    if {mapbrowser_auto::restored} is set:
        stop
    if {_p} is not online:
        stop
    if {_p} does not have permission "mapbrowser.command.create":
        stop
    if name of world of {_p} is not "SakuraSpawn":
        stop
    send "[MapBrowser] Recreando pantallas (post-reinicio)..." to console
    make {_p} execute command "mb create 117 -49 -53 https://www.google.com 2 2"
    wait 4 seconds
    if {_p} is not online:
        stop
    make {_p} execute command "mb create 70 -57 -88 https://example.com 2 2"
    set {mapbrowser_auto::restored} to true
    send "[MapBrowser] Pantallas recreadas (2)." to console

command /mapbrowserrestore:
    permission: mapbrowser.command.create
    permission message: "&cNecesitas mapbrowser.command.create"
    trigger:
        delete {mapbrowser_auto::restored}
        mapbrowserRestoreAs(player)

every 30 seconds:
    if {mapbrowser_auto::restored} is set:
        stop
    loop all players:
        if loop-player has permission "mapbrowser.command.create":
            if name of world of loop-player is "SakuraSpawn":
                mapbrowserRestoreAs(loop-player)
                stop loop

on join:
    wait 5 seconds
    if {mapbrowser_auto::restored} is set:
        stop
    if player has permission "mapbrowser.command.create":
        if name of world of player is "SakuraSpawn":
            mapbrowserRestoreAs(player)

on world change:
    wait 8 ticks
    if {mapbrowser_auto::restored} is set:
        stop
    if event-world is not world "SakuraSpawn":
        stop
    if player has permission "mapbrowser.command.create":
        mapbrowserRestoreAs(player)
