# Filtro de chat de Con Los Pibes.
#  - Groserías: se censuran palabra por palabra (no por subcadena: "computadora" no se toca).
#  - Publicidad: bloquea IPs y dominios ("algo.com", "algo punto net", "1.2.3.4").
#  - Spam: 1.5 s entre mensajes y no repetir el mismo mensaje en 20 s.
#  - Mayúsculas: un mensaje entero en mayúsculas (más de 8 letras) pasa a minúsculas.
# Exentos: permiso conlospibes.chat.bypass (grupo moderador y admin).
# Para añadir/quitar palabras edita la lista de abajo y usa /sk reload chat-filter.sk

options:
    words: "puta", "puto", "putas", "putos", "hijueputa", "hijoputa", "hdp", "pendejo", "pendeja", "pendejos", "cabron", "cabrón", "cabrones", "gilipollas", "maricon", "maricón", "marica", "maricas", "verga", "vergas", "careverga", "coño", "culero", "culera", "malparido", "malparida", "gonorrea", "perra", "zorra", "mamaguevo", "mamahuevo", "mamaguevos", "subnormal", "retrasado", "nigga", "nigger", "niggas", "faggot", "fag", "whore", "slut", "fuck", "fucking", "motherfucker" and "cunt"
    bypass: conlospibes.chat.bypass

on load:
    delete {-chatfilter::*}
    loop {@words}:
        add loop-value to {-chatfilter::*}

function chatClean(w: text) :: text:
    set {_c} to lowercase {_w}
    loop ".", ",", "!", "?", "¡", "¿", ";", ":", "*", "-", "_", "'" and """":
        replace all loop-value in {_c} with ""
    return {_c}

function stars(n: number) :: text:
    set {_s} to ""
    loop {_n} times:
        set {_s} to "%{_s}%*"
    return {_s}

on chat:
    player does not have permission "{@bypass}"
    set {_msg} to message
    set {_low} to lowercase {_msg}
    # publicidad: IPs y dominios
    if {_low} matches ".*\b(\d{1,3}[.,]){3}\d{1,3}\b.*":
        cancel event
        send "&cNo se permite publicar IPs en el chat." to player
        stop
    if {_low} matches ".*[a-z0-9-]{2,}\s*(\.|\(dot\)|\[dot\]| punto )\s*(com|net|org|gg|io|xyz|me|es|co|tk|ml|ga|cf|club|pro|fun|online|site|store|live|tv)\b.*":
        cancel event
        send "&cNo se permite publicar enlaces ni servidores en el chat." to player
        stop
    # spam
    if {-chat.last::%uuid of player%} is set:
        if difference between {-chat.last::%uuid of player%} and now is less than 1.5 seconds:
            cancel event
            send "&cVas muy rápido, espera un momento antes de escribir." to player
            stop
    if {-chat.lastmsg::%uuid of player%} is {_low}:
        if difference between {-chat.last::%uuid of player%} and now is less than 20 seconds:
            cancel event
            send "&cNo repitas el mismo mensaje." to player
            stop
    set {-chat.last::%uuid of player%} to now
    set {-chat.lastmsg::%uuid of player%} to {_low}
    # mayúsculas
    if length of {_msg} > 8:
        # all letters uppercase (Skript text comparisons ignore case, regex does not)
        if {_msg} matches "[^a-záéíóúñ]*[A-ZÁÉÍÓÚÑ][^a-záéíóúñ]*":
            set {_msg} to lowercase {_msg}
    # groserías (palabra por palabra)
    set {_words::*} to {_msg} split at " "
    set {_changed} to false
    loop {_words::*}:
        if {-chatfilter::*} contains chatClean(loop-value):
            set {_words::%loop-index%} to stars(length of loop-value)
            set {_changed} to true
    if {_changed} is true:
        set {_msg} to join {_words::*} with " "
    set message to {_msg}

on quit:
    delete {-chat.last::%uuid of player%}
    delete {-chat.lastmsg::%uuid of player%}
