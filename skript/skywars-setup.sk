# Guía rápida para crear la arena skywars1 en SkyWars X (requiere OP in-game)
command /swsetup:
    permission: skywars.admin
    permission message: "&cNecesitas permiso skywars.admin"
    trigger:
        send "" to player
        send "&6&lSkyWars X &7- Setup arena &eskywars1" to player
        send "&7El plugin solo crea arenas con comandos in-game." to player
        send "" to player
        send "&e0. &7Si la carpeta rota existe, un admin puede borrarla desde consola." to player
        send "&8   &f/data/plugins/Skywars/arenas/skywars1" to player
        send "" to player
        send "&e1. &7Ve al lobby: &f/mv tp lobbySW" to player
        send "&e2. &7Define lobby SW: &f/sw setlobby" to player
        send "&e3. &7Ve al mapa: &f/mv tp skywars1" to player
        send "&e4. &7Pide la varita: &f/sw wand" to player
        send "&e5. &7Marca esquina &a1&7: &f-160 85 -190 &7(bloque inferior)" to player
        send "&e6. &7Marca esquina &a2&7: &f10 140 10 &7(bloque superior)" to player
        send "&e7. &7Crea la arena: &f/sw create skywars1 1 2 4 normal" to player
        send "&8   (espera el escaneo de bloques - puede tardar)" to player
        send "&e8. &7Anade spawns con &f/sw addspawn skywars1 &7en:" to player
        send "&8   * -145.5 112 -99.5" to player
        send "&8   * -83.5 114 -172.5" to player
        send "&8   * -82.5 115 -35.5" to player
        send "&8   * -27.5 114 -99.5" to player
        send "&e9. &7Espectadores: &f/sw setspectators skywars1 &7(en -86.5 123 -99.5)" to player
        send "&e10. &7Activa: &f/sw edit skywars1 &7-> enabled ON" to player
        send "&e11. &7Recarga: &f/sw reload" to player
        send "&e12. &7Prueba: &f/sw join skywars1" to player
        send "" to player
        send "&cSi /sw list muestra Loaded arenas: 0,&7 revisa &flocations.dat&7:" to player
        send "&8   Cuboid entre comillas, coords con espacios tras cada coma." to player
        send "&8   &fbash scripts/deploy-skywars-arena.sh" to player
        send "" to player
        send "&aTip: &7Con FAWE activo, tras crear usa &f/sw updateregion skywars1" to player
        send "&7para generar el schematic de rollback." to player
        send "" to player
