# Spawn SakuraSpawn al join (HungerGames mete a HGLobby).
# Bienvenida visual: WelcomeAds + Oraxen (no CSCinematic automático).

options:
    spawn-world: SakuraSpawn
    spawn-x: 23.478
    spawn-y: -61
    spawn-z: -92.564
    spawn-yaw: -89.2
    spawn-pitch: -0.8

function goSpawn(p: player):
    set {_loc} to location at {@spawn-x}, {@spawn-y}, {@spawn-z} in world "{@spawn-world}"
    set yaw of {_loc} to {@spawn-yaw}
    set pitch of {_loc} to {@spawn-pitch}
    teleport {_p} to {_loc}

function forceSakuraSpawn(p: player):
    if {_p} is not online:
        stop
    if {_p}'s world's name is not "{@spawn-world}":
        execute console command "mv tp %name of {_p}% {@spawn-world}"
        wait 10 ticks
    if {_p} is not online:
        stop
    goSpawn({_p})

on join:
    wait 5 ticks
    if player is not online:
        stop
    forceSakuraSpawn(player)
    wait 15 ticks
    if player is online:
        forceSakuraSpawn(player)
